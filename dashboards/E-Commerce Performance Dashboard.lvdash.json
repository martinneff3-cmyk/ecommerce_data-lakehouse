    {
      "name": "61228724",
      "displayName": "top_ten_products",
      "queryLines": [
        "SELECT \r\n",
        "    product_id,\r\n",
        "    ROUND(SUM(revenue), 2) AS total_product_revenue\r\n",
        "FROM product_performance\r\n",
        "GROUP BY product_id\r\n",
        "ORDER BY total_product_revenue DESC\r\n",
        "LIMIT 10;"
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    },
    {
      "name": "8a6098a5",
      "displayName": "products_sold_top",
      "queryLines": [
        "SELECT\r\n",
        "    product_id,\r\n",
        "    SUM(units_sold)\r\n",
        "    AS total_sold\r\n",
        "FROM product_performance\r\n",
        "GROUP BY product_id\r\n",
        "ORDER BY total_sold DESC\r\n",
        "LIMIT 10\r\n",
        "\r\n",
        "    "
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    },
    {
      "name": "419727cf",
      "displayName": "top_customers_by_revenue",
      "queryLines": [
        "SELECT \r\n",
        "    customer_id,\r\n",
        "    ROUND(SUM(total_revenue), 2) AS total_revenue\r\n",
        "FROM customer_metrics\r\n",
        "GROUP BY customer_id\r\n",
        "ORDER BY total_revenue DESC\r\n",
        "LIMIT 10;"
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    },
    {
      "name": "337bfe7d",
      "displayName": "revenue_by_country",
      "queryLines": [
        "SELECT\r\n",
        "country,\r\n",
        "ROUND(SUM(total_revenue), 2) AS total_revenue\r\n",
        "FROM customer_metrics\r\n",
        "GROUP BY country\r\n",
        "ORDER BY total_revenue DESC;"
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    },
    {
      "name": "9ce0ce63",
      "displayName": "number_of_customers",
      "queryLines": [
        "SELECT\r\n",
        "  COUNT(DISTINCT customer_id) AS total_customers\r\n",
        "FROM customer_metrics;"
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    },
    {
      "name": "0ec55342",
      "displayName": "customers_total_revenue",
      "queryLines": [
        "SELECT\r\n",
        "  ROUND(SUM(total_revenue), 2) AS total_revenue\r\n",
        "FROM customer_metrics;"
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    },
    {
      "name": "3201b26e",
      "displayName": "product_cart_conversion",
      "queryLines": [
        "SELECT\r\n",
        "  CONCAT(conversion_from_previous_step_pct,\" %\") AS cart_conversion_rate\r\n",
        "FROM conversion_funnel\r\n",
        "WHERE funnel_step_order = 2;"
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    },
    {
      "name": "2056a53c",
      "displayName": "cart_checkout_conversion",
      "queryLines": [
        "SELECT\r\n",
        "CONCAT(conversion_from_previous_step_pct, \" %\") AS checkout_conversion\r\n",
        "FROM conversion_funnel\r\n",
        "WHERE funnel_step_order = 3;"
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    },
    {
      "name": "58173f17",
      "displayName": "checkout_purchase",
      "queryLines": [
        "SELECT\r\n",
        "CONCAT(conversion_from_previous_step_pct, \" %\") AS checkout_purchase\r\n",
        "FROM conversion_funnel\r\n",
        "WHERE funnel_step_order = 4;"
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    },
    {
      "name": "c4f586c8",
      "displayName": "conv_funnel_1",
      "queryLines": [
        "SELECT\r\n",
        "CONCAT(funnel_step_order, \". \", funnel_step) AS funnel_step,\r\n",
        "session_count\r\n",
        "FROM conversion_funnel\r\n",
        "ORDER BY funnel_step_order;"
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    },
    {
      "name": "d167d113",
      "displayName": "product_purchase",
      "queryLines": [
        "SELECT\r\n",
        "CONCAT(overall_conversion_rate_pct, \" %\") AS product_purchase\r\n",
        "FROM conversion_funnel\r\n",
        "WHERE funnel_step_order = 4;"
      ],
      "catalog": "ecommerce_catalog",
      "schema": "gold"
    }
  ],
